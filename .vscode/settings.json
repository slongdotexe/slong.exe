{
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "aws.cloudformation.diagnostics.cfnLint.path": "/opt/homebrew/bin/cfn-lint",
  "files.associations": {
    "**/applications/*/template*.yaml": "cloudformation",
    "**/infra/*/template*.yaml": "cloudformation",
    "**/infra/*/*/template*.yaml": "cloudformation",
    "**/libraries/*/template*.yaml": "cloudformation"
  },
}
