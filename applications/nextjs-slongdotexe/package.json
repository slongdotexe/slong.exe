{
  "name": "@slongdotexe/nextjs-slongdotexe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cache": "node scripts/build-cache-artifact.mts",
    "build:cdn": "node infra/cdn-cloudfront/scripts/build-cloudfront-handler.mts && node infra/cdn-cloudfront/scripts/build-preview-handler.mts",
    "test": "node --test src/*.test.mjs src/cache/*.test.mjs infra/cdn-cloudfront/scripts/*.test.mjs",
    "typecheck:cdn": "tsc --project infra/tsconfig.json",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/signature-v4a": "^3.1138.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "^0.13.0",
    "@opentelemetry/api": "1.9.1",
    "aws-rum-web": "^3.2.1",
    "next": "^16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "yaml": "^2.8.1"
  },
  "packageManager": "yarn@4.18.0"
}
